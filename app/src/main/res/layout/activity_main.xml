<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Group 5: Geofence Alert"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Active Geofence Details -->
    <TextView
        android:id="@+id/tvGeofenceDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Geofence:\nLatitude: 6.9271\nLongitude: 79.8612\nRadius: 100 meters"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:background="#EFEFEF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnRegisterGeofence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register Geofence"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Not Registered"
        android:textSize="16sp"
        android:textStyle="italic"
        android:textColor="#555555" />

</LinearLayout>